# Port configuration
PORT=4000

# Working directory.
# Temporary files and directories will be created here.
WORK_DIR=./.workdir

# Database filename
DB_FILENAME=videos.db

# You can choose a provider of generative AI from OpenAI or LM Studio.
# OpenAI wins when both values are set.
# OpenAI API key for some features
OPENAI_API_KEY=
# Hostname of LM Studio
LM_STUDIO_HOST=http://localhost:1234

# Video Storage Configuration
# Options: filesystem (default), s3
VIDEO_STORAGE_TYPE=filesystem

# S3 Configuration (required when VIDEO_STORAGE_TYPE=s3)
# S3_BUCKET_NAME=ourtube-videostorage
# AWS_REGION=ap-northeast-1


# Note: AWS credentials should be configured via:
# - Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# - AWS CLI configuration: aws configure
# - IAM roles (for EC2/ECS/Lambda)
